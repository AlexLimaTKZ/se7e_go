# Turso Database
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token

# Auth - Defina a senha de acesso ao app
APP_PASSWORD=sua-senha-aqui
# Segredo aleatorio independente, com pelo menos 32 bytes
AUTH_SECRET=gere-um-segredo-longo-e-aleatorio

# Vercel Blob (imagens de produtos)
BLOB_READ_WRITE_TOKEN=vercel_blob_token_here
